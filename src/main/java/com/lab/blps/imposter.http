# 5️⃣ Финансовый отдел проверяет реквизиты (может отклонить)
POST http://localhost:8080/blps-0.0.1-SNAPSHOT-plain/api/finance/paymentinfo/4/validate?paymentStatus=REJECTED
Authorization: Bearer {{fin}}


###

# 6️⃣ Разработчик исправляет реквизиты и снова отправляет
POST http://localhost:8080/blps-0.0.1-SNAPSHOT-plain/api/developer/applications/4/monetization/request?accountNumber=2134567890
Authorization: Bearer {{dev}}
###

# 7️⃣ Финансовый отдел повторно проверяет реквизиты (утверждает)
POST http://localhost:8080/blps-0.0.1-SNAPSHOT-plain/api/finance/paymentinfo/1/validate?paymentStatus=APPROVED
Authorization: Bearer {{fin}}


###

# 8️⃣ Финансовый отдел создаёт договор
POST http://localhost:8080/blps-0.0.1-SNAPSHOT-plain/api/finance/contracts?applicationId=6&pdfPath=/path/to/contract.pdf
Authorization: Bearer {{fin}}


###

# 9️⃣ Разработчик подписывает договор (или отказывается)
# Если разработчик отказывается, пропустите следующий шаг
GET http://localhost:8080/blps-0.0.1-SNAPSHOT-plain/api/developer/contracts/1
Authorization: Bearer {{dev}}

